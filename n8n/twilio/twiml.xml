<?xml version="1.0" encoding="UTF-8"?>
<Response>
    <Say voice="Polly.Mia-Neural" language="es-US">
        Bienvenido a la mesa de ayuda.
        Describi tu problema despues del tono.
        Cuando termines, presiona numeral.
        Tenes hasta cuarenta y cinco segundos.
    </Say>
    <!-- La transcripcion se entrega por Twilio Event Streams
         (com.twilio.voice.insights.call-summary.complete) al trigger de N8N.
         No se usa el transcribeCallback legacy ni se embebe un dominio placeholder. -->
    <Record
        maxLength="45"
        finishOnKey="#"
        transcribe="true"
        playBeep="true"
    />
    <Say voice="Polly.Mia-Neural" language="es-US">
        Gracias. Tu incidente fue registrado.
        Vas a recibir un numero de ticket por correo.
    </Say>
</Response>
