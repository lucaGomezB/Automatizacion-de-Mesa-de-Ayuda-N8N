# .env.example -- Variables para el entorno Docker local (raiz del repo)
# El docker-compose.yml de la raiz lee la configuracion del backend desde
# App/Backend/.env -- asegurate de que ese archivo este completo.
#
# Las variables de este archivo son para el docker-compose raiz (N8N y networking).
# Copiarlo como .env en la raiz si necesitas sobreescribir alguna variable.
# NUNCA commitear .env con valores reales al repositorio.

# URL del backend FastAPI (dentro de la red Docker de este compose).
# Valor por defecto en docker-compose.yml: http://backend:8000
# Sobreescribir solo si usas un backend externo al compose.
BACKEND_URL=http://backend:8000

# Puerto del host donde escucha N8N (por defecto 5678).
N8N_PORT=5678

# ── Credenciales del entorno local ──────────────────────────────────────────
# El docker-compose raiz usa estas variables con fallback a los defaults de
# desarrollo. Sobreescribir en este archivo (copiado a .env, gitignorado) para
# usar credenciales propias. NUNCA commitear valores reales.
#
# OJO: si un volumen postgres_data ya fue inicializado con otra password,
# cambiar POSTGRES_PASSWORD no la actualiza en el volumen. Definir el valor
# viejo aqui o recrear el volumen con `docker compose down -v`.
POSTGRES_USER=mesa
POSTGRES_PASSWORD=mesa_local_dev
POSTGRES_DB=mesa_de_ayuda

# Autenticacion basica de N8N (UI y webhooks).
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8n_local_dev

# Destinatario de la notificacion de revision humana del workflow N8N.
# La lee el nodo 'Notificar operador designado' como $env.OPERATOR_EMAIL
# cuando el backend responde requiere_revision_humana = true.
# Valor por defecto en docker-compose.yml: operador@example.com (placeholder).
OPERATOR_EMAIL=operador@example.com

# Secreto compartido de la guarda de costo en runtime (c-45).
# FUENTE UNICA para el stack Docker: docker-compose lo inyecta TANTO en el
# backend como en n8n con la misma interpolacion, de modo que ambos comparten el
# mismo valor y no pueden divergir. En el stack Docker este valor prevalece sobre
# el de App/Backend/.env (que se usa para correr el backend fuera de compose).
#   - Backend: lo exige como header X-Cost-Guard-Secret en
#     POST /api/v1/cost-guard/reserve.
#   - n8n: el nodo 'Guard de costo' lo envia en ese header como
#     $env.COST_GUARD_SHARED_SECRET.
# Vacio = endpoint de reserva cerrado (HTTP 401) y degradacion a revision humana.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
COST_GUARD_SHARED_SECRET=

# Confianza del backend en los headers reenviados por el proxy Nginx (c-45, W1).
# Uvicorn la lee para honrar X-Forwarded-Proto y reconstruir la URL publica
# https sobre la que Twilio firma el webhook de voz. Default en docker-compose:
# `*` (confia en cualquier cliente de la red interna). Es seguro porque el puerto
# 8000 del backend NO se publica al host (solo Nginx expone 80/443) y Nginx
# sobreescribe X-Forwarded-Proto con $scheme: un cliente externo no puede
# falsificar el esquema. Para fijar una subred de proxy concreta, definir aqui la
# lista separada por comas (p. ej. 172.18.0.0/16). NO dejar vacio: deshabilitaria
# la confianza y el webhook de Twilio responderia 401 por firma invalida.
FORWARDED_ALLOW_IPS=*
