# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Gestion de Incidentes API"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=production

# ── Database ──────────────────────────────────────────────────────────────────
# Use postgresql+asyncpg for production, sqlite+aiosqlite for local dev
DATABASE_URL=postgresql+asyncpg://mesa:mesa@localhost:5432/mesa_de_ayuda
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyDuAKMDV_lUatr-rAma7CobkbTR-Jjckm8
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_TOP_P=0.9
GEMINI_MAX_OUTPUT_TOKENS=100
GEMINI_CANDIDATE_COUNT=1
GEMINI_TIMEOUT_SECONDS=10

# ── Classifier Thresholds ─────────────────────────────────────────────────────
DETERMINISTIC_CONFIDENCE_THRESHOLD=0.90
HUMAN_REVIEW_THRESHOLD=0.70

# ── N8N Integration ───────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
