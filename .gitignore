# Backup files (generated by scripts/backup.sh and scripts/backup.ps1) + snapshots
backups/*
!backups/.gitkeep

# Corpus de evaluacion (Ley 25.326): se versiona SOLO la version pseudonimizada
# (`corpus_evaluacion_pseudonimizado.json` y `Corpus Tesis - Hoja 1 (pseudonimizado).csv`).
# El original pre-pseudonimizacion (crudo) NUNCA se versiona.
data/Corpus Tesis.xlsx
data/Corpus Tesis - Hoja 1.csv

# Sidecars de resultados de los harness de ingesta.
# Se versionan SOLO los sidecars completos y PII-free (sin descripciones):
#   data/corpus_resultados.json            (200 filas)
#   data/corpus_resultados_telefonia.json  (81 filas)
# Cualquier otro sidecar del patron queda excluido por defecto: en particular
# data/corpus_resultados_n8n.json (pendiente de resolver su discrepancia de conteo,
# 4 filas frente a 119; OQ2) y cualquier sidecar futuro que pudiera llevar
# descripciones. Ver data/README.md.
data/corpus_resultados*.json
!data/corpus_resultados.json
!data/corpus_resultados_telefonia.json

# Locks transitorios de LibreOffice sobre los archivos del corpus
data/.~lock*

# Caches de predicciones del framework de evaluacion (derivan del corpus real, PII)
evaluation/predicciones.json
evaluation/predicciones_calibracion.json
# Salidas de la ablacion paga del prompt (c-142, D9): derivan del corpus real, no se versionan
evaluation/predicciones_sensibilidad_prompt_*.json
# NOTA: evaluation/report.md NO se ignora. Es evidencia agregada del resultado de la
# evaluacion (metricas, matriz de confusion, tiempos) y se versiona con el repositorio.
