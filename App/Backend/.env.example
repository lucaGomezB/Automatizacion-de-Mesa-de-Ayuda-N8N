# Gestion de Incidentes API - Variables de entorno
# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear .env con claves reales al repositorio.

# Base de datos PostgreSQL
# Formato: postgresql+asyncpg://usuario:clave@host:5432/nombre_db
DATABASE_URL=postgresql+asyncpg://usuario:clave@localhost:5432/gestion_incidentes

# Google Gemini 2.5 Flash (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Integracion con N8N (dejar vacio para deshabilitar notificaciones)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Pseudonimizacion (Ley 25.326)
# Dominios corporativos internos adicionales a enmascarar como [HOST].
# Ejemplo: PSEUDONYMIZATION_INTERNAL_DOMAINS=["corp.empresa.com","empresa.local"]
PSEUDONYMIZATION_INTERNAL_DOMAINS=[]

# Clave Fernet para cifrar descripcion_original at-rest. OBLIGATORIA.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANTE: guardar la clave de forma segura; perderla hace ilegible la descripcion_original.
PSEUDONYMIZATION_ENCRYPTION_KEY=your-fernet-key-here

# Autenticacion JWT
# Clave secreta para firmar tokens JWT (HS256). OBLIGATORIA.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here
# JWT_ALGORITHM=HS256       # Algoritmo de firma (default: HS256)
# JWT_EXPIRE_MINUTES=1440    # Expiracion del token en minutos (default: 24 horas)

# Twilio (canal telefonico) — C-16
# Las credenciales de Twilio pertenecen al trigger de N8N (receptor del webhook),
# NO al backend FastAPI: el backend no consume estas variables hoy. Se mantienen
# comentadas como referencia hasta que exista un uso real en el backend (C-34, A4).
# TWILIO_ACCOUNT_SID=your_account_sid_here
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+54xxxxxxxxxx
# TWILIO_WEBHOOK_URL=https://your-ngrok-url.ngrok.io/webhook/transcripcion
