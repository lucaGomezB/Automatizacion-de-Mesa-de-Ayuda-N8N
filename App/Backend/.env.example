# Gestion de Incidentes API - Variables de entorno
# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear .env con claves reales al repositorio.

# Base de datos PostgreSQL
# Formato: postgresql+asyncpg://usuario:clave@host:5432/nombre_db
DATABASE_URL=postgresql+asyncpg://usuario:clave@localhost:5432/gestion_incidentes

# Google Gemini 2.5 Flash (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Integracion con N8N (dejar vacio para deshabilitar notificaciones)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Pseudonimizacion (Ley 25.326)
# Dominios corporativos internos adicionales a enmascarar como [HOST].
# Ejemplo: PSEUDONYMIZATION_INTERNAL_DOMAINS=["corp.empresa.com","empresa.local"]
PSEUDONYMIZATION_INTERNAL_DOMAINS=[]

# Clave Fernet para cifrar descripcion_original at-rest. OBLIGATORIA.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANTE: guardar la clave de forma segura; perderla hace ilegible la descripcion_original.
PSEUDONYMIZATION_ENCRYPTION_KEY=your-fernet-key-here

# Autenticacion JWT
# Clave secreta para firmar tokens JWT (HS256). OBLIGATORIA.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here
# JWT_ALGORITHM=HS256       # Algoritmo de firma (default: HS256)
# JWT_EXPIRE_MINUTES=1440    # Expiracion del token en minutos (default: 24 horas)

# Twilio (canal telefonico) — C-16 / c-45
# TWILIO_AUTH_TOKEN SI se consume en el backend desde c-45: el webhook de voz
# pre-llamada (`POST /api/v1/cost-guard/twilio/voice`) lo usa para validar la
# firma `X-Twilio-Signature` (HMAC-SHA1). Con token, toda peticion sin firma
# valida recibe HTTP 401. Sin token (credencial pendiente) el webhook responde
# HTTP 401 (fail-closed) y el arranque advierte cost_guard_twilio_token_missing:
# CARGAR EL VALOR REAL LUEGO, al activar el canal telefonico.
# Las demas credenciales de Twilio pertenecen al trigger de N8N (receptor del
# webhook). Se mantienen comentadas como referencia.
# TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+54xxxxxxxxxx
# TWILIO_WEBHOOK_URL=https://your-ngrok-url.ngrok.io/webhook/transcripcion

# Guarda de costo en runtime (c-45)
# Tope de gasto pago de las tres superficies (Gemini backend, AI Agent de n8n y
# transcripcion Twilio) con una bolsa GLOBAL compartida. Viene HABILITADA por
# defecto con un default conservador; todas las variables son opcionales.
# Los costos unitarios son ESTIMACIONES configurables, no contabilidad exacta.
# COST_GUARD_ENABLED=true
# COST_GUARD_BUDGET_USD=10.0
# COST_GUARD_BUDGET_WINDOW_SECONDS=604800
# COST_GUARD_UNIT_COST_BACKEND_GEMINI_USD=0.0005
# COST_GUARD_UNIT_COST_N8N_GEMINI_USD=0.0015
# COST_GUARD_UNIT_COST_TWILIO_TRANSCRIPTION_USD=0.05
# COST_GUARD_RATE_LIMIT_CALLS=30
# COST_GUARD_RATE_WINDOW_SECONDS=3600
# COST_GUARD_CALLER_RATE_LIMIT_CALLS=3
# COST_GUARD_CALLER_RATE_WINDOW_SECONDS=3600
# COST_GUARD_DEGRADATION_POLICY=deterministic_review
# Politica ante almacen de contadores caido. Default fail_closed (recomendado).
# fail_open permite la llamada paga SIN tope cuando el almacen cae: usar solo de
# forma deliberada. Cualquier valor distinto de fail_open se trata como fail_closed.
# COST_GUARD_STORE_FAILURE_POLICY=fail_closed
# Notificacion externa adicional (webhook N8N, N8N_WEBHOOK_URL) cuando el almacen
# cae. El evento estructurado cost_guard_store_unavailable se emite SIEMPRE; este
# flag solo controla la notificacion externa adicional.
# COST_GUARD_ALERT_ENABLED=true
# Secreto compartido OBLIGATORIO del endpoint de reserva que consume n8n
# (`POST /api/v1/cost-guard/reserve`). Se envia en el header
# `X-Cost-Guard-Secret`; NUNCA por query string (se registraria en logs). Si
# queda vacio, el endpoint responde HTTP 401 y el arranque emite la advertencia
# `cost_guard_secret_missing`. El webhook de voz de Twilio NO usa este secreto:
# se autentica con `X-Twilio-Signature`.
# En el stack Docker, la FUENTE UNICA es el .env de la RAIZ del repo:
# docker-compose inyecta alli el valor tanto en el backend como en n8n. Este
# archivo se usa para correr el backend fuera de compose.
COST_GUARD_SHARED_SECRET=
