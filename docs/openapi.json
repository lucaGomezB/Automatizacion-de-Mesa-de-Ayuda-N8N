    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Iniciar sesion y obtener token JWT",
        "description": "Autentica al usuario con username y password, retornando un token JWT.\n\nEl token debe enviarse en el header Authorization de requests subsiguientes:\n    Authorization: Bearer <access_token>\n\nEl token expira segun la configuracion JWT_EXPIRE_MINUTES (24 horas por defecto).\n\nArgs:\n    payload: Credenciales de inicio de sesion (username + password).\n\nReturns:\n    TokenResponse con access_token y token_type \"bearer\" (HTTP 200).\n\nRaises:\n    JSONResponse 401: Si las credenciales son invalidas.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/incidentes/": {
      "post": {
        "tags": [
          "Incidentes"
        ],
        "summary": "Crear y clasificar un incidente",
        "description": "Crea un nuevo incidente y ejecuta la clasificación automática.\n\nInvocado por N8N tras recibir un correo electrónico en Outlook o una\ntranscripción de llamada de Twilio, o directamente desde un cliente HTTP.\n\nEl incidente se persiste en estado \"nuevo\" y es clasificado inmediatamente\npor el pipeline híbrido (determinístico + Gemini). El resultado incluye\nel sector asignado, la confianza de la clasificación y el indicador\nde revisión humana si la confianza fue insuficiente.\n\nArgs:\n    payload: Descripción pseudonimizada del incidente, prioridad y canal.\n\nReturns:\n    Representación completa del incidente creado y clasificado (HTTP 201).",
        "operationId": "create_incidente_api_v1_incidentes__post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidenteCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidenteRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Incidentes"
        ],
        "summary": "Listar incidentes con filtros opcionales",
        "description": "Lista incidentes con filtros combinables y paginación.\n\nTodos los parámetros de filtro son opcionales y se combinan con AND lógico.\nEl resultado se ordena por fecha de creación descendente (más reciente primero).\nRetorna la proyección ligera IncidenteListItem (sin texto de descripción)\npara optimizar el tamaño de la respuesta en consultas masivas.",
        "operationId": "list_incidentes_api_v1_incidentes__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "sector_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por sector responsable",
              "title": "Sector Id"
            },
            "description": "Filtrar por sector responsable"
          },
          {
            "name": "estado_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por estado del ciclo de vida",
              "title": "Estado Id"
            },
            "description": "Filtrar por estado del ciclo de vida"
          },
          {
            "name": "prioridad",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/PrioridadEnum"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por nivel de prioridad",
              "title": "Prioridad"
            },
            "description": "Filtrar por nivel de prioridad"
          },
          {
            "name": "requiere_revision_humana",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por indicador de revisión pendiente",
              "title": "Requiere Revision Humana"
            },
            "description": "Filtrar por indicador de revisión pendiente"
          },
          {
            "name": "desde",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Fecha de creación mínima (ISO 8601)",
              "title": "Desde"
            },
            "description": "Fecha de creación mínima (ISO 8601)"
          },
          {
            "name": "hasta",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Fecha de creación máxima (ISO 8601)",
              "title": "Hasta"
            },
            "description": "Fecha de creación máxima (ISO 8601)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Cantidad máxima de resultados",
              "default": 50,
              "title": "Limit"
