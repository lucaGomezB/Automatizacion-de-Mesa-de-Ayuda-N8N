            "type": "string",
            "title": "Descripcion Pseudonimizada"
          },
          "prioridad": {
            "$ref": "#/components/schemas/PrioridadEnum"
          },
          "requiere_revision_humana": {
            "type": "boolean",
            "title": "Requiere Revision Humana"
          },
