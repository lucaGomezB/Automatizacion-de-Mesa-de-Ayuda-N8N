    "/api/v1/estadisticas/resumen": {
      "get": {
        "tags": [
          "Estadisticas"
        ],
        "summary": "Obtener resumen de KPIs del dashboard",
        "description": "Retorna KPIs agregados: total de incidentes, promedio diario,\ndistribucion por sector y estado, y tasa de revision humana.\n\nSi no se especifican fechas, se usa el rango de los ultimos 30 dias.",
        "operationId": "get_resumen_api_v1_estadisticas_resumen_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
