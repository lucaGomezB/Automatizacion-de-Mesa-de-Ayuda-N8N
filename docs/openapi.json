                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "descripcion_pseudonimizada",
          "prioridad",
          "requiere_revision_humana",
          "created_at",
          "updated_at",
          "sector",
          "estado",
          "canal_origen"
        ],
        "title": "IncidenteRead",
        "description": "Representación completa de un incidente para el endpoint de detalle.\n\nIncluye los objetos relacionados completos (sector, estado, canal_origen)\nen lugar de solo sus IDs, para que el cliente no necesite realizar\nconsultas adicionales para obtener sus nombres.\n\nPolítica de privacidad (C-03, Ley 25.326):\n    Solo se expone 'descripcion_pseudonimizada' (texto con etiquetas PII).\n    'descripcion_original' (cifrada, con PII) NO forma parte de esta respuesta."
      },
      "IncidenteUpdate": {
        "properties": {
