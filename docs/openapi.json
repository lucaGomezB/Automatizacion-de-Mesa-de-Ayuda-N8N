      "IncidenteCreate": {
        "properties": {
          "descripcion": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 10,
            "title": "Descripcion",
            "description": "Texto pseudonimizado del incidente. Mínimo 10 caracteres."
          },
          "prioridad": {
            "$ref": "#/components/schemas/PrioridadEnum",
            "default": "media"
          },
          "canal_origen_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canal Origen Id"
          }
        },
        "type": "object",
        "required": [
          "descripcion"
        ],
        "title": "IncidenteCreate",
        "description": "Payload de creación de un incidente.\n\nAceptado por el endpoint POST /api/v1/incidentes. Puede provenir de:\n    - El webhook de N8N tras recibir un correo electrónico en Outlook.\n    - El webhook de N8N tras procesar la transcripción de una llamada en Twilio.\n    - Una llamada directa a la API desde un cliente externo.\n\nValidaciones de negocio:\n    - La descripción no puede estar en blanco ni ser solo espacios.\n    - La longitud mínima de 10 caracteres evita incidentes vacíos de contenido.\n    - La longitud máxima de 5000 caracteres previene abusos de almacenamiento."
      },
      "IncidenteListItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "prioridad": {
